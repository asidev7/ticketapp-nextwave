# =========================================================================
# NextWave Party — environment variables
# Copy to `.env` and fill in. NEVER commit the real .env.
# =========================================================================

# --- Django ---------------------------------------------------------------
# Settings module: config.settings.dev (local) or config.settings.prod (server)
DJANGO_SETTINGS_MODULE=config.settings.dev
# Long random string. Generate:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=change-me
DEBUG=True
# Comma-separated host names (production: nextwaveparty.com,www.nextwaveparty.com)
ALLOWED_HOSTS=localhost,127.0.0.1
# Production: https://nextwaveparty.com,https://www.nextwaveparty.com
CSRF_TRUSTED_ORIGINS=
# Public URL of the site, no trailing slash. Used in e-mails, payment
# callbacks and webhook URLs. Production: https://nextwaveparty.com
SITE_URL=http://localhost:8000
# Admin URL (keep it non-obvious)
ADMIN_URL=nwp-admin/

# --- Database -------------------------------------------------------------
# SQLite by default in development. Production (PostgreSQL):
#   DATABASE_URL=postgres://nextwave:password@localhost:5432/nextwave
DATABASE_URL=sqlite:///db.sqlite3

# --- Redis / Celery ---------------------------------------------------------
# Leave empty to run tasks synchronously (no Redis needed in development).
# Production: redis://localhost:6379/0
REDIS_URL=
# Optional overrides (defaults derive from REDIS_URL)
# CELERY_BROKER_URL=redis://localhost:6379/1
# CELERY_TASK_ALWAYS_EAGER=False

# --- E-mail (SMTP) --------------------------------------------------------
# Development default prints e-mails in the console.
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
DEFAULT_FROM_EMAIL=NextWave Party <tickets@nextwaveparty.com>

# --- Secrets for tickets and payment keys ---------------------------------
# Fernet key that encrypts the payment gateway keys stored in the database.
# REQUIRED in production. Generate:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Changing it makes the stored gateway keys unreadable (re-enter them in the admin).
FIELD_ENCRYPTION_KEY=
# HMAC key that signs the QR codes. REQUIRED in production.
# Changing it invalidates every ticket already issued!
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
QR_SECRET_KEY=

# --- Options --------------------------------------------------------------
# Minutes a pending order keeps its tickets reserved
ORDER_RESERVATION_MINUTES=15
# FeexPay API host (change only if FeexPay gives you another one)
FEEXPAY_API_BASE=https://api.feexpay.me
# Ticket PDF engine: weasyprint (default) or pillow
TICKET_PDF_ENGINE=weasyprint
# Optional explicit font files for the PNG ticket (Arial; Liberation Sans is
# metric-compatible and used automatically when Arial is absent)
# TICKET_FONT_REGULAR=/usr/share/fonts/truetype/msttcorefonts/Arial.ttf
# TICKET_FONT_BOLD=/usr/share/fonts/truetype/msttcorefonts/Arial_Bold.ttf
# Rate limits
CHECKOUT_RATE=20/h
FIND_TICKET_RATE=5/h
SCANNER_LOGIN_RATE=10/15m
# Behind Nginx, the client IP header used by the rate limiter
# RATELIMIT_IP_META_KEY=HTTP_X_REAL_IP
