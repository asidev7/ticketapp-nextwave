# /etc/systemd/system/nextwave-celery-beat.service
# Releases expired 15-minute reservations every minute.
[Unit]
Description=NextWave Party (Celery beat)
After=network.target redis-server.service

[Service]
User=nextwave
Group=www-data
WorkingDirectory=/srv/nextwave
EnvironmentFile=/srv/nextwave/.env
Environment=DJANGO_SETTINGS_MODULE=config.settings.prod
ExecStart=/srv/nextwave/.venv/bin/celery -A config beat --loglevel=INFO --schedule=/srv/nextwave/celerybeat-schedule
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
