# /etc/systemd/system/nextwave-celery.service
[Unit]
Description=NextWave Party (Celery worker)
After=network.target redis-server.service

[Service]
User=nextwave
Group=www-data
WorkingDirectory=/srv/nextwave
EnvironmentFile=/srv/nextwave/.env
Environment=DJANGO_SETTINGS_MODULE=config.settings.prod
ExecStart=/srv/nextwave/.venv/bin/celery -A config worker --loglevel=INFO --concurrency=2
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
