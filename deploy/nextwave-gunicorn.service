# /etc/systemd/system/nextwave-gunicorn.service
[Unit]
Description=NextWave Party (Gunicorn)
After=network.target postgresql.service redis-server.service

[Service]
User=nextwave
Group=www-data
WorkingDirectory=/srv/nextwave
EnvironmentFile=/srv/nextwave/.env
Environment=DJANGO_SETTINGS_MODULE=config.settings.prod
ExecStart=/srv/nextwave/.venv/bin/gunicorn config.wsgi:application \
    --bind 127.0.0.1:8000 --workers 3 --timeout 60 --access-logfile -
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
