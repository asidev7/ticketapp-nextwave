    "fields": {
      "site_name": "NextWave Party",
      "meta_description": "XMAS with Q-Dot — Dec 25 & 26, 2026 at J5 Lounge, Ilara (Ogun State). 1 ticket covers 2 days. Buy your ticket online.",
      "primary_color": "#C8102E",
      "accent_color": "#F5B921",
      "contact_email": "hello@nextwaveparty.com",
      "contact_phone": "07070257650",
      "whatsapp": "",
      "instagram": "https://instagram.com/nextwaveparty",
      "facebook": "",
